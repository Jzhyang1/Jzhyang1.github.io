---
---

<div class="shell">
  <div id="topbar" class="topbar">/</div>
  <div id="shell-content" class="shell-content">
    <div id="output" class="output"></div>
    <form id="shell-form">
      <span id="current-path">$ </span>
      <input id="command-input" type="text" autocomplete="off" spellcheck="false" />
    </form>
  </div>
</div>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    width: 50%;
    min-width: 350px;
    max-width: 50vw;
    height: 70%;
    min-height: 300px;
    max-height: 60vh;
    color: #fff;
    font-family: monospace;
  }

  .shell-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    background: #000;
    padding: 20px;
    overflow-y: auto;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
  }

  .topbar {
    background-color: #444;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    padding-left: 20px;
    padding-top: 5px;
    padding-bottom: 5px;
  }

  .output {
    display: flex;
    flex-direction: column;
    width: 100%;
    word-break: break-all;
    white-space: pre-wrap;
  }

  .output :global(.dir) {
    color: #4da6ff;
    font-weight: bold;
  }

  #shell-form {
    display: flex;
    flex-direction: row;
    flex: none;
  }

  #current-path {
    white-space: nowrap;
  }

  input {
    flex: 1;
    background: none;
    border: none;
    color: #fff;
    outline: none;
    font-family: monospace;
    padding-left: 8px;
    width: fit-content;
  }
</style>

<script>
  import { runCommand, type OutputLine, type ShellContext } from "../lib/shell/commands";
  import { completeToken } from "../lib/shell/autocomplete";
  import { CommandHistory } from "../lib/shell/history";

  const HISTORY_LIMIT = 100;

  const topbarElement = document.getElementById("topbar")!;
  const shellContentElement = document.getElementById("shell-content")!;
  const outputElement = document.getElementById("output")!;
  const commandInput = document.getElementById("command-input") as HTMLInputElement;
  const shellForm = document.getElementById("shell-form")!;
  const currentPathElement = document.getElementById("current-path")!;

  const ctx: ShellContext = { path: [] };
  const history = new CommandHistory(HISTORY_LIMIT);

  const promptText = () => `$ `;

  const appendLine = (line: OutputLine, className?: string) => {
    const div = document.createElement("div");
    if (className) div.className = className;

    if (typeof line === "string") {
      div.textContent = line;
    } else {
      for (const segment of line) {
        const span = document.createElement("span");
        span.textContent = segment.text;
        if (segment.className) span.className = segment.className;
        div.appendChild(span);
      }
    }

    outputElement.appendChild(div);
    shellContentElement.scrollTop = shellContentElement.scrollHeight;
  };

  const refreshPrompt = () => {
    currentPathElement.textContent = promptText();
    topbarElement.textContent = `/${ctx.path.join("/")}`;
  };

  const submitCommand = (command: string) => {
    // Feature 1: echo the entered command into the scrollback before its output.
    appendLine(`${promptText()}${command}`, "echoed-command");

    const result = runCommand(command, ctx);
    if (result.clear) {
      outputElement.replaceChildren();
    } else {
      result.lines.forEach((line) => appendLine(line));
    }

    history.push(command);
    refreshPrompt();
  };

  const handleTab = (event: KeyboardEvent) => {
    event.preventDefault();
    const value = commandInput.value;
    const match = value.match(/\S+$/);
    if (!match || match.index === undefined) return;

    const completed = completeToken(ctx.path, match[0]);
    if (completed) commandInput.value = value.slice(0, match.index) + completed;
  };

  const handleHistoryNav = (event: KeyboardEvent) => {
    event.preventDefault();
    const next =
      event.key === "ArrowUp" ? history.previous(commandInput.value) : history.next();
    if (next !== null) commandInput.value = next;
  };

  shellForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const command = commandInput.value;
    commandInput.value = "";
    submitCommand(command);
  });

  commandInput.addEventListener("keydown", (event) => {
    if (event.key === "Tab") handleTab(event);
    else if (event.key === "ArrowUp" || event.key === "ArrowDown") handleHistoryNav(event);
  });

  shellContentElement.addEventListener("click", () => commandInput.focus());
</script>
