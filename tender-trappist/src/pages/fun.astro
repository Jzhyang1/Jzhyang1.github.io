---
import background from '../assets/background.svg';
import Layout from '../layouts/Layout.astro';

export interface Props {
  date?: Date;
}

const date = new Date();

// Simple deterministic hash function for a date string (YYYY-MM-DD)
function hashDate(dateString: string): number {
  let hash = 0;
  for (let i = 0; i < dateString.length; i++) {
    const char = dateString.charCodeAt(i);
    hash = (hash << 5) - hash + char;
    hash |= 0; // Convert to 32-bit integer
  }
  // Map to a normalized float [0, 1)
  return (Math.abs(hash) % 1000000) / 1000000;
}

function formatDate(d: Date): string {
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

// Check raw 1-in-20 chance for a specific date
function isRawFunDay(d: Date): boolean {
  const dateStr = formatDate(d);
  const score = hashDate(dateStr);
  return score < 0.05; // 5% chance (1 in 20)
}

// Main logic enforcing the minimal distance rule within a 7-day window
function evaluateDay(targetDate: Date) {
  // Check if target date triggers raw probability
  const rawHit = isRawFunDay(targetDate);

  if (!rawHit) {
    return { isFun: false, reason: 'Unlucky' };
  }

  // Look back at the past 6 days to suppress clustering
  for (let i = 1; i <= 6; i++) {
    const pastDate = new Date(targetDate);
    pastDate.setDate(targetDate.getDate() - i);

    if (isRawFunDay(pastDate)) {
      return {
        isFun: false,
        reason: `You already had a fun day ${i} days ago`,
      };
    }
  }

  return { isFun: true, reason: 'The stars have aligned!' };
}

const result = evaluateDay(date);
const formattedDateString = date.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Build the Sun–Sat calendar week containing `date`
const weekStart = new Date(date);
weekStart.setHours(0, 0, 0, 0);
weekStart.setDate(date.getDate() - date.getDay());

const weekDays = Array.from({ length: 7 }, (_, i) => {
  const day = new Date(weekStart);
  day.setDate(weekStart.getDate() + i);
  return {
    date: day,
    label: day.toLocaleDateString('en-US', { weekday: 'short' }),
    dayOfMonth: day.getDate(),
    isToday: formatDate(day) === formatDate(date),
    ...evaluateDay(day),
  };
});
---

<Layout>
  <main class="fun-page">
    <img class="fun-background" src={background.src} alt="" fetchpriority="high" />
    <div class="fun-overlay" aria-hidden="true"></div>

    <section class="fun-card">
      <p class="fun-kicker">Fun check</p>
      <h1 class="fun-date">{formattedDateString}</h1>

      {result.isFun ? (
        <div class="fun-status fun">
          <h2>Today is FUN!</h2>
        </div>
      ) : (
        <div class="fun-status not-fun">
          <h2>Today is NOT Fun.</h2>
        </div>
      )}

      <p class="fun-reason">{result.reason}</p>
    </section>

    <section class="week-view">
      {weekDays.map((day) => (
        <div class:list={['week-day', { 'is-today': day.isToday, 'is-fun': day.isFun }]}>
          <span class="week-day-label">{day.label}</span>
          <span class="week-day-number">{day.dayOfMonth}</span>
          <span class="week-day-icon" aria-hidden="true">{day.isFun ? '🎉' : '·'}</span>
        </div>
      ))}
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: #020817;
  }

  .fun-page {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 2rem 1rem;
  }

  .fun-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.72;
    filter: saturate(1.2) contrast(1.05);
  }

  .fun-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top, rgba(251, 191, 36, 0.18), transparent 30%),
      linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.35));
  }

  .fun-card {
    position: relative;
    z-index: 1;
    width: min(560px, 100%);
    padding: 2.25rem 2rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.62);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(14px);
    text-align: center;
  }

  .fun-kicker {
    margin: 0 0 0.75rem;
    color: #cbd5e1;
    letter-spacing: 0.18em;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .fun-date {
    margin: 0;
    color: #f8fafc;
    font-size: clamp(1.5rem, 2vw, 2.2rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .fun-status {
    margin-top: 1.5rem;
  }

  .fun-status h2 {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .fun-status.fun h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(90deg, #fbbf24, #f472b6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: bounce 1s ease-in-out;
    text-shadow: 0 10px 30px rgba(251, 191, 36, 0.2);
  }

  .fun-status.not-fun h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #cbd5e1;
  }

  .fun-reason {
    margin: 1.25rem 0 0;
    color: rgba(226, 232, 240, 0.82);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-8px);
    }
    50% {
      transform: translateY(0);
    }
    75% {
      transform: translateY(-4px);
    }
  }

  @media (max-width: 640px) {
    .fun-card {
      padding: 1.5rem 1.25rem;
    }

    .fun-status.fun h2 {
      font-size: 2.5rem;
    }

    .fun-status.not-fun h2 {
      font-size: 2rem;
    }
  }

  .week-view {
    position: relative;
    z-index: 1;
    width: min(560px, 100%);
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
  }

  .week-day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(10px);
  }

  .week-day-label {
    color: #94a3b8;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .week-day-number {
    color: #f8fafc;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .week-day-icon {
    font-size: 1rem;
    line-height: 1;
    color: rgba(148, 163, 184, 0.6);
  }

  .week-day.is-fun {
    border-color: rgba(251, 191, 36, 0.5);
    background: linear-gradient(160deg, rgba(251, 191, 36, 0.16), rgba(244, 114, 182, 0.12));
  }

  .week-day.is-today {
    border-color: #f472b6;
    box-shadow: 0 0 0 2px rgba(244, 114, 182, 0.35);
  }

  @media (max-width: 640px) {
    .week-view {
      gap: 0.35rem;
    }

    .week-day {
      padding: 0.5rem 0.15rem;
      border-radius: 0.75rem;
    }

    .week-day-number {
      font-size: 0.9rem;
    }
  }
</style>
